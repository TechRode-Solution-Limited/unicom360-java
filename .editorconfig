root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[mvnw.cmd]
end_of_line = crlf

# Vendored from unicom360-openapi: never reformat (the tree hash in VERSION covers every byte).
[src/test/resources/conformance/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
